<%- include('../partials/header') %>

<article class="route-detail" data-trip-id="<%= details.id %>" data-is-available="<%= availability.isAvailable %>">
  <div class="route-header">
    <div class="route-header-content">
      <h1 class="route-name"><%= details.name %></h1>
      <p class="route-description page-description"><%= details.description %></p>

      <% if (details.highlights && details.highlights.length > 0) { %>
      <div class="highlights">
        <% details.highlights.forEach(function(highlight) { %>
        <span class="highlight-tag"><%= highlight %></span>
        <% }); %>
      </div>
      <% } %>
    </div>

    <% if (details.imageUrl) { %>
    <div class="route-image">
      <img src="<%= details.imageUrl %>" alt="<%= details.name %>">
    </div>
    <% } %>
  </div>

  <% if (!availability.isAvailable) { %>
  <p class="booking-availability-notice" role="status"><%= availability.message %> Please check back later.</p>
  <% } %>

  <div class="route-info">
    <div class="info-grid">
      <div class="info-item">
        <span class="info-label">Region</span>
        <span class="info-value region-<%= details.region %>"><%= details.region.charAt(0).toUpperCase() + details.region.slice(1) %></span>
      </div>

      <div class="info-item">
        <span class="info-label">Duration</span>
        <span class="info-value"><%= details.duration %></span>
      </div>

      <div class="info-item">
        <span class="info-label">Distance</span>
        <span class="info-value"><%= details.distance %> km</span>
      </div>

      <div class="info-item">
        <span class="info-label">Best Season</span>
        <span class="info-value season-<%= details.bestSeason %>"><%= details.bestSeason.charAt(0).toUpperCase() + details.bestSeason.slice(1) %></span>
      </div>

      <div class="info-item train-info-item">
        <span class="info-label">Train</span>
        <% if (train) { %>
        <a class="info-value train-info" href="/trains/<%= encodeURIComponent(train.id) %>">
          <span class="train-visual<%= train.imageUrl ? "" : " is-image-missing" %>">
            <% if (train.imageUrl) { %>
            <img class="train-info-image" src="<%= train.imageUrl %>" alt="<%= train.imageAlt || train.name %>">
            <% } %>
            <span class="train-info-placeholder" aria-hidden="true">
              <svg viewBox="0 0 48 48" focusable="false">
                <path d="M15 7h18a6 6 0 0 1 6 6v19a5 5 0 0 1-5 5H14a5 5 0 0 1-5-5V13a6 6 0 0 1 6-6Z" />
                <path d="M10 25h28M17 15h14M16 37l-4 5m20-5 4 5M16 32h.01M32 32h.01" />
              </svg>
            </span>
          </span>
          <span class="train-info-copy">
            <span class="train-info-name"><%= train.name %></span>
            <span class="train-info-action">View train details</span>
          </span>
          <span class="train-info-arrow" aria-hidden="true">↗</span>
        </a>
        <% } else { %>
        <span class="info-value train-info train-info-unavailable">
          <span class="train-visual is-image-missing" aria-hidden="true">
            <span class="train-info-placeholder">
              <svg viewBox="0 0 48 48" focusable="false">
                <path d="M15 7h18a6 6 0 0 1 6 6v19a5 5 0 0 1-5 5H14a5 5 0 0 1-5-5V13a6 6 0 0 1 6-6Z" />
                <path d="M10 25h28M17 15h14M16 37l-4 5m20-5 4 5M16 32h.01M32 32h.01" />
              </svg>
            </span>
          </span>
          <span class="train-info-copy">
            <span class="train-info-name"><%= details.trainId
              ? `Train record unavailable (${details.trainId})`
              : "Train information unavailable" %></span>
            <span class="train-info-action">Details unavailable</span>
          </span>
        </span>
        <% } %>
      </div>
    </div>

    <div class="route-stations">
      <h2>Trip</h2>
      <div class="stations">
        <div class="station">
          <span class="station-label">Start</span>
          <span class="station-name-row">
            <span class="station-name"><%= details.startStation.charAt(0).toUpperCase() + details.startStation.slice(1) %></span>
            <button type="button" class="station-info-btn" data-station-id="<%= details.startStation %>" aria-haspopup="dialog" aria-label="View station information">ⓘ</button>
          </span>
        </div>
        <div class="station">
          <span class="station-label">End</span>
          <span class="station-name-row">
            <span class="station-name"><%= details.endStation.charAt(0).toUpperCase() + details.endStation.slice(1) %></span>
            <button type="button" class="station-info-btn" data-station-id="<%= details.endStation %>" aria-haspopup="dialog" aria-label="View station information">ⓘ</button>
          </span>
        </div>
      </div>
    </div>

    <div class="route-operating">
      <h2>Operating Schedule</h2>
      <div class="months-grid">
        <% details.operatingMonths.forEach(function(month) { %>
        <span class="month-badge"><%= month %></span>
        <% }); %>
      </div>
    </div>

    <div class="route-schedules">
      <h2>Available Schedules</h2>

      <label for="monthSelect">Select month</label>
      <select id="monthSelect">
        <option value="">All operating months</option>
        <% for (let month = 1; month <= 12; month++) { %>
        <option value="<%= month %>"><%= month %></option>
        <% } %>
      </select>

      <div id="scheduleStatus" class="schedule-status">Loading schedules...</div>
      <div id="scheduleGrid" class="schedules-grid"></div>
    </div>
  </div>
</article>

<div id="stationPopup" class="station-popup" hidden>
  <div class="station-popup-backdrop" data-close-popup></div>
  <div class="station-popup-content" role="dialog" aria-modal="true" aria-labelledby="stationPopupName">
    <button type="button" class="station-popup-close" data-close-popup aria-label="Close station information">&times;</button>
    <div id="stationPopupBody" class="station-popup-body">
      <p>Loading station information...</p>
    </div>
  </div>
</div>

<script src="/js/details.js" defer></script>

<%- include('../partials/footer') %>