<%- include('./partials/header') %>
<section class="trains-hero">
    <h1><%= title %></h1>
    <% if (isAdmin) { %>
        <a href="/admin" class="admin-trips-back">&larr; Back to Admin Dashboard</a>
    <% } %>
</section>
<section
    class="trains-catalog"
    id="bookings-admin"
    data-is-admin="<%= isAdmin %>"
    data-bookings-scope="<%= bookingsScope %>"
    data-current-user-id="<%= currentUserId %>"
    data-current-user-email="<%= currentUserEmail %>"
>
    <div class="trains-state" id="bookings-loading">Loading Bookings...</div>
    <div class="trains-state trains-error" id="bookings-error" hidden></div>
    <div class="trains-state" id="bookings-empty" hidden>
        No bookings found.
    </div>

        <div class="trains-grid" id="bookings-list"></div>

        <div class="pagination-controls" id="pagination-controls">
            <button id="prev-page" class="btn-pagination" disabled>Previous</button>
            <span id="current-page">Page 1</span>
            <button id="next-page" class="btn-pagination">Next</button>
        </div>

        <div class="sorting-controls" id="sorting-controls">
            <label for="sort-by">Sort By:</label>
            <select id="sort-by">
            </select>
            <label for="sort-order">Sort order:</label>
            <select id="sort-order">
            </select>
        </div>

        <div class="booking-filters" id="booking-filter-form">
            <form class="booking-filters-form" method="get">
                <label for="ticket-class">Ticket Class:</label>
                <select id="ticket-class" name="ticketClass">
                    <option value="">All Classes</option> 
                </select>

                <label for="start-date">Booking Start Date:</label>
                <input type="date" id="start-date" name="startDate">

                <label for="end-date">Booking End Date:</label>
                <input type="date" id="end-date" name="endDate">

                <button type="submit" class="btn-filter" id="btn-booking-filter">Filter</button>
            </form>
        </div>
        <template id="booking-card-template">
            <article class="train-card">
                <header class="train-card-header">
                    <a class="booking-confirmation-link">
                        <h2 data-field="name"></h2>
                        <span class="train-operator booking-email" data-field="email"></span>
                    </a>
                </header>

                <p class="train-description" data-field="ticket"></p>

                <dl class="train-specs">
                    <div class="spec-item">
                        <dt>Trip</dt>
                        <dd data-field="tripId"></dd>
                    </div>
                    <div class="spec-item">
                        <dt>Travel Day</dt>
                        <dd data-field="selectedDay"></dd>
                    </div>
                    <div class="spec-item">
                        <dt>Passengers</dt>
                        <dd data-field="passengers"></dd>
                    </div>
                    <div class="spec-item">
                        <dt>Confirmation</dt>
                        <dd data-field="confirmationId"></dd>
                    </div>
                    <div class="spec-item">
                        <dt>Booked By</dt>
                        <dd data-field="owner"></dd>
                    </div>
                    <div class="spec-item">
                        <dt>Booked On</dt>
                        <dd data-field="bookingDate"></dd>
                    </div>
                </dl>

                <div class="booking-view-actions">
                    <button type="button" class="btn-edit-passengers">Edit</button>
                    <button type="button" class="btn-upgrade-booking">
                        Upgrade
                    </button>
                    <button type="button" class="btn-delete-booking">Delete</button>
                </div>
                <p class="booking-owner-message" hidden></p>

                <dialog class="booking-flow-dialog booking-passenger-dialog" aria-label="Edit passenger details">
                    <form class="booking-passengers-form">
                        <header class="booking-dialog-header">
                            <h2>Edit passenger details</h2>
                            <p>Update the traveler information for this booking.</p>
                        </header>
                        <div class="booking-passenger-fields"></div>
                        <p class="booking-passenger-error" role="alert" hidden></p>
                        <div class="booking-dialog-actions">
                            <button type="button" class="btn-cancel-passenger-edit">
                                Cancel
                            </button>
                            <button type="submit" class="btn-save-passengers">
                                Save changes
                            </button>
                        </div>
                    </form>
                </dialog>

                <dialog class="booking-flow-dialog booking-upgrade-dialog" aria-label="Upgrade booking">
                    <form class="booking-upgrade-form">
                        <header class="booking-dialog-header">
                            <h2>Upgrade all seats</h2>
                            <p>
                                Choose a higher class. The price difference updates
                                before you confirm.
                            </p>
                        </header>
                        <label class="booking-upgrade-select">
                            New ticket class
                            <select name="ticketClass" required></select>
                        </label>
                        <p class="booking-upgrade-quote" aria-live="polite" hidden></p>
                        <div class="booking-dialog-actions">
                            <button type="button" class="btn-cancel-upgrade">
                                Cancel
                            </button>
                            <button type="submit" class="btn-save-booking" hidden>
                                Confirm upgrade
                            </button>
                        </div>
                    </form>
                </dialog>

                <dialog class="booking-flow-dialog booking-delete-dialog" aria-label="Delete booking">
                    <div class="booking-dialog-header">
                        <h2>Delete booking?</h2>
                        <p>
                            This permanently deletes the booking and its passenger
                            details.
                        </p>
                    </div>
                    <p class="booking-delete-error" role="alert" hidden></p>
                    <div class="booking-dialog-actions">
                        <button type="button" class="btn-cancel-delete">
                            Keep booking
                        </button>
                        <button type="button" class="btn-delete-confirm">
                            Delete booking
                        </button>
                    </div>
                </dialog>
            </article>
        </template>

    </section>

    <%- include('./partials/footer') %>